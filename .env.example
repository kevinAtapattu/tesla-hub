# --- Tesla developer app (developer.tesla.com → your app → Credentials & APIs) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Domain hosting your public key, no https:// (e.g. yourname.github.io)
TESLA_DOMAIN=
# na = North America & Asia-Pacific (incl. Canada), eu = Europe/Middle East/Africa
TESLA_REGION=na
# Optional: pin a VIN if the account has several cars (default: the first one)
TESLA_VIN=

# --- Hub ---
# Must match the redirect URI registered in your Tesla app: <PUBLIC_BASE_URL>/auth/callback
PUBLIC_BASE_URL=http://localhost:8095
TZ=America/Toronto
# Set this before exposing the dashboard beyond this computer (e.g. for the car's browser)
DASHBOARD_PASSWORD=
GRAFANA_ADMIN_PASSWORD=admin

# --- Polling (every Fleet API request is billed; ~$0.002 per data request) ---
POLL_SLEEP_CHECK=20m
POLL_DRIVING=2m
POLL_CHARGING=5m
POLL_PARKED=20m
MONTHLY_REQUEST_BUDGET=4000

# --- Assistant (optional) ---
# Lets you text or tell Siri "warm it up, I'll be there in 15". Get a key at
# console.anthropic.com -> API Keys (pay as you go; a few messages a day costs cents).
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5

# Drive alerts are posted to Discord: channel → Edit Channel → Integrations → Webhooks.
# DISCORD_USER_ID (Developer Mode → right-click yourself → Copy User ID) gets @mentioned.
DISCORD_WEBHOOK_URL=
DISCORD_USER_ID=
