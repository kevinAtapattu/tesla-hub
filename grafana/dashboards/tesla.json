          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, battery_level AS \"Battery %\", charge_limit AS \"Limit %\" FROM vehicle_states WHERE $__timeFilter(time) ORDER BY 1"
