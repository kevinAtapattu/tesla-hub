{
  "host": "0.0.0.0",
  "port": 443,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tesla_telemetry",
  "reliable_ack": false,
  "transmit_decoded_records": true,
  "rate_limit": { "enabled": true, "message_interval_time": 30, "message_limit": 1000 },
  "zmq": { "addr": "tcp://0.0.0.0:5284" },
  "records": {
    "V": ["zmq"],
    "alerts": ["zmq"],
    "errors": ["zmq", "logger"],
    "connectivity": ["zmq", "logger"]
  },
  "tls": {
    "server_cert": "/etc/certs/server.crt",
    "server_key": "/etc/certs/server.key"
  }
}
